{
  "name": "dashtro",
  "version": "0.1.0",
  "description": "Declarative, code-first dashboards for Astro. Write SQL and markup, get pretty live charts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://forgejo.pm4.uk/peter/dashtro.git"
  },
  "homepage": "https://forgejo.pm4.uk/peter/dashtro#readme",
  "bugs": {
    "url": "https://forgejo.pm4.uk/peter/dashtro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "dist/routes/*.js"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "dashboard",
    "duckdb",
    "postgres",
    "sql",
    "charts",
    "recharts"
  ],
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./routes/query": "./dist/routes/query.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle-react.mjs && node scripts/copy-static.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.0",
    "@duckdb/node-api": ">=1.4.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "pg": ">=8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/mdx": {
      "optional": true
    },
    "@astrojs/react": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "motion": "^13.4.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.3.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@duckdb/node-api": "1.5.5-r.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
